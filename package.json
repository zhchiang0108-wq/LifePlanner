{
  "name": "life-planner-tdd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node app/main.ts",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/tdd.mjs check",
    "test:unit": "node --test --test-isolation=none \"tests/*.test.ts\"",
    "test:case": "node scripts/test-case.mjs",
    "test:properties": "node --test tests/properties/overlaps.test.ts",
    "test:mutation": "npm exec --yes --package=@stryker-mutator/core@10.1.1 -- stryker run",
    "test": "npm run test:unit && npm run test:properties && vitest run"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "express": "^5.1.0",
    "pg": "8.23.1",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "fast-check": "4.10.3",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.0.0",
    "vitest": "^3.2.4",
    "playwright": "1.65.1"
  }
}
