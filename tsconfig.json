{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "scripts/browser-traces.ts", "vitest.config.ts"]
}
